diff -ruN -u0 a/getv/port/fast3d/gfx_opengl.c b/getv/port/fast3d/gfx_opengl.c
--- a/getv/port/fast3d/gfx_opengl.c	2026-10-03 22:09:10.294399945 +0000
+++ b/getv/port/fast3d/gfx_opengl.c	2026-10-03 22:09:10.306400048 +0000
@@ -66,0 +67 @@
+#include "../src/ge_stall_watchdog.h"
@@ -991,0 +993,2 @@
+    int drawdiag_selected = 0;
+
@@ -1029,0 +1033 @@
+        drawdiag_selected = geDrawDiagLastSelected();
@@ -1032,0 +1037,11 @@
+
+    /* Attribution diagnostic only. The existing draw filter decides which submission is
+     * selected; when GETV_DRAWDIAG_SYNC=1, synchronise immediately after that selected draw.
+     * A GPU hang therefore leaves the just-printed drawdiag line as the exact selected draw
+     * whose completion we were waiting for (or the first selected sync point after prior work).
+     * Normal rendering never executes this glFinish(). */
+    if (drawdiag_selected && gePortDrawSyncEnabled()) {
+        gePortStallGfxPhase(11);
+        glFinish();
+        gePortStallGfxPhase(3);
+    }
