+static s32 ge_proxbox_debug_on(void)
+{
+    static s32 cached = -1;
+
+    if (cached < 0)
+    {
+        extern char *getenv(const char *);
+        const char *e = getenv("GETV_PROXBOX_DEBUG");
+        cached = (e && *e == '1') ? 1 : 0;
+    }
+
+    return cached;
+}
+
+static s32 ge_proxbox_source_weapon(struct Explosion *exp)
+{
+    PropRecord *source;
+
+    if (!exp)
+    {
+        return -1;
+    }
+
+    source = exp->source;
+
+    if (source && source->type == PROP_TYPE_WEAPON && source->weapon)
+    {
+        return source->weapon->weaponnum;
+    }
+
+    return -1;
+}
+
+static s32 ge_proxbox_roomlist_count(void)
+{
+    s32 i;
+
+    for (i = 0; i < PTR_LIST_OBJECT_LOOKUP_INDICES_LEN; i++)
+    {
+        if (ptr_list_object_lookup_indices[i] < 0)
+        {
+            return i;
+        }
+    }
+
+    return PTR_LIST_OBJECT_LOOKUP_INDICES_LEN;
+}
