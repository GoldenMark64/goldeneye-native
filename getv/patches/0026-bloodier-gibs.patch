+/* Blood is a separate bounded cosmetic pool: it cannot evict retail debris or
+ * consume gameplay props. Positions remain in world units, including ray hits
+ * converted back from the background renderer's scaled coordinates. */
+#define GE_BLOOD_STAINS 512
+#define GE_BLOOD_DROPS 128
+struct GeBloodStain {
+    coord3d position;
+    coord3d offsets[GE_BLOOD_POLY_MAX];
+    s16 uv[GE_BLOOD_POLY_MAX][2];
+    s32 count, age, room;
+    u8 pool, major, shade;
+};
+struct GeBloodDrop {
+    coord3d position, velocity;
+    s32 age, life, room;
+    f32 size;
+    u8 mist;
+};
+static struct GeBloodStain ge_blood_stains[GE_BLOOD_STAINS];
+static struct GeBloodDrop ge_blood_drops[GE_BLOOD_DROPS];
+static u32 ge_blood_next_stain, ge_blood_next_drop;
+static s32 ge_blood_surface_hits[3];
+static u64 ge_blood_mask_words[GE_BLOOD_MASK_SIZE*GE_BLOOD_MASK_SIZE/8];
+static s32 ge_blood_mask_ready;
+
+void explosionResetBloodEffects(void)
+{
+    memset(ge_blood_stains, 0, sizeof(ge_blood_stains));
+    memset(ge_blood_drops, 0, sizeof(ge_blood_drops));
+    memset(ge_gib_physics, 0, sizeof(ge_gib_physics));
+    memset(ge_blood_surface_hits, 0, sizeof(ge_blood_surface_hits));
+    ge_blood_next_stain = ge_blood_next_drop = 0;
+    ge_gib_selftest_age = -1;
+}
