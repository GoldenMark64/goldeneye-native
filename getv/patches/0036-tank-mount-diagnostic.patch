+static void ge_tankdebug_nearest_tank(void)
+{
+    PropRecord *prop;
+    PropRecord *best = NULL;
+    f32 best_dist2 = -1.0f;
+
+    for (prop = chrpropGetActiveTail(); prop != NULL; prop = prop->prev) {
+        if (prop->type == PROP_TYPE_OBJ && prop->obj != NULL && prop->obj->type == PROPDEF_TANK) {
+            f32 dx = prop->pos.f[0] - g_CurrentPlayer->field_488.collision_position.f[0];
+            f32 dz = prop->pos.f[2] - g_CurrentPlayer->field_488.collision_position.f[2];
+            f32 dist2 = dx * dx + dz * dz;
+
+            if (best == NULL || dist2 < best_dist2) {
+                best = prop;
+                best_dist2 = dist2;
+            }
+        }
+    }
+
+    if (best != NULL) {
+        struct rect4f *polygon = NULL;
+        s32 edges = 0;
+        f32 top = 0.0f;
+        f32 bottom = 0.0f;
+        s32 player_room = g_CurrentPlayer->field_488.current_tile_ptr != NULL
+            ? g_CurrentPlayer->field_488.current_tile_ptr->room : -1;
+
+        chraiGetCollisionBounds(best, &polygon, &edges, &top, &bottom);
+        osSyncPrintf("[getv][tank] nearest prop=%p obj=%p dist=%.2f proptype=%d objtype=%d "
+                     "flags=%08x state=%u colblk=%p edges=%d poly=%p y=(%.2f,%.2f) "
+                     "rooms=%u,%u,%u,%u playerroom=%d stan=%p pos=(%.2f,%.2f,%.2f)\n",
+                     (void *)best, (void *)best->obj, (double)sqrtf(best_dist2),
+                     (s32)best->type, (s32)best->obj->type,
+                     (u32)best->obj->flags, (u32)best->obj->state,
+                     (void *)best->obj->ptr_allocated_collisiondata_block,
+                     edges, (void *)polygon, (double)bottom, (double)top,
+                     (u32)best->rooms[0], (u32)best->rooms[1],
+                     (u32)best->rooms[2], (u32)best->rooms[3], player_room,
+                     (void *)best->stan,
+                     (double)best->pos.f[0], (double)best->pos.f[1], (double)best->pos.f[2]);
+    } else {
+        osSyncPrintf("[getv][tank] nearest none active\n");
+    }
+}
