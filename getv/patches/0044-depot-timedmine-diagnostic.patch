+typedef struct GeTimedMineDebugState
+{
+    WeaponObjRecord *weapon;
+    s32 ticks;
+    s32 last_bucket;
+    s32 last_shuffle;
+    s32 last_objtype;
+    s32 last_proptype;
+    s32 last_weaponnum;
+    s32 initialized;
+} GeTimedMineDebugState;
+
+static GeTimedMineDebugState ge_timedmine_debug_states[4];
+
+static s32 ge_timedmine_debug_on(void)
+{
+    static s32 cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv("GETV_TIMEDMINE_DEBUG");
+        cached = (e && *e == '1') ? 1 : 0;
+    }
+    return cached;
+}
+
+static GeTimedMineDebugState *ge_timedmine_debug_state(WeaponObjRecord *weapon)
+{
+    s32 i;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (ge_timedmine_debug_states[i].weapon == weapon)
+        {
+            return &ge_timedmine_debug_states[i];
+        }
+    }
+
+    for (i = 0; i < 4; i++)
+    {
+        if (!ge_timedmine_debug_states[i].weapon)
+        {
+            ge_timedmine_debug_states[i].weapon = weapon;
+            ge_timedmine_debug_states[i].last_bucket = -9999;
+            ge_timedmine_debug_states[i].last_shuffle = -9999;
+            ge_timedmine_debug_states[i].last_objtype = -9999;
+            ge_timedmine_debug_states[i].last_proptype = -9999;
+            ge_timedmine_debug_states[i].last_weaponnum = -9999;
+            return &ge_timedmine_debug_states[i];
+        }
+    }
+
+    return &ge_timedmine_debug_states[0];
+}
+
+static s32 ge_timedmine_debug_matches(ObjectRecord *obj, WeaponObjRecord *weapon)
+{
+    return obj && weapon
+        && (weapon->weaponnum == ITEM_TIMEDMINE || obj->obj == PROP_CHRTIMEDMINE);
+}
+
+static void ge_timedmine_debug_tick(const char *phase, PropRecord *prop, ObjectRecord *obj,
+                                    WeaponObjRecord *weapon, s32 advance, s32 force)
+{
+    GeTimedMineDebugState *state;
+    s32 bucket;
+    s32 shuffle;
+    s32 proptype;
+    s32 changed;
+
+    if (!ge_timedmine_debug_on() || !ge_timedmine_debug_matches(obj, weapon))
+    {
+        return;
+    }
+
+    state = ge_timedmine_debug_state(weapon);
+    if (advance)
+    {
+        state->ticks++;
+    }
+
+    bucket = weapon->timer >= 0 ? (weapon->timer + 59) / 60 : -1;
+    shuffle = get_player_position_in_shuffled(get_cur_playernum());
+    proptype = prop ? prop->type : -1;
+    changed = !state->initialized
+        || state->last_bucket != bucket
+        || state->last_shuffle != shuffle
+        || state->last_objtype != obj->type
+        || state->last_proptype != proptype
+        || state->last_weaponnum != weapon->weaponnum;
+
+    if (force || changed || weapon->timer <= 10)
+    {
+        printf("[getv][timedmine] %s tick=%d obj=%p prop=%p objtype=%d proptype=%d "
+               "model=%d weapon=%d timer=%d clock=%d shuffle=%d runtime=0x%x "
+               "projectile=%p hasprojectile=%d\n",
+               phase, state->ticks, (void *)obj, (void *)prop, obj->type, proptype,
+               obj->obj, weapon->weaponnum, weapon->timer, g_ClockTimer, shuffle,
+               obj->runtime_bitflags, (void *)obj->projectile,
+               (obj->runtime_bitflags & RUNTIMEBITFLAG_HASPROJECTILE) != 0);
+        fflush(stdout);
+    }
+
+    state->initialized = 1;
+    state->last_bucket = bucket;
+    state->last_shuffle = shuffle;
+    state->last_objtype = obj->type;
+    state->last_proptype = proptype;
+    state->last_weaponnum = weapon->weaponnum;
+}
