+static s32 geBloodTrace(coord3d *from, coord3d *to, s32 *room, HitThing *hit)
+{
+    u8 initial[8], final[8];
+    s32 rooms[16], count=0, i, found=0;
+    f32 nearest=1.0e30f, scale=get_room_data_float1();
+    if (*room<=0 || *room>=g_MaxNumRooms || scale<=0.0f) return 0;
+    memset(initial, 0xff, sizeof(initial));
+    initial[0]=(u8)*room;
+    bgFindRoomsAlongSegment(from, to, initial, final, rooms, &count, 16);
+    for (i=0; i<count; i++) {
+        HitThing candidate;
+        s32 axis;
+        f32 dist=0.0f, projection=0.0f, segment_length_sq=0.0f;
+        if (rooms[i]<=0 || rooms[i]>=g_MaxNumRooms) continue;
+        if (!bgTestBulletHitBackground(from,to,rooms[i],&candidate)) continue;
+        for (axis=0; axis<3; axis++) {
+            f32 delta;
+            candidate.hitpos.f[axis]/=scale;
+            delta=candidate.hitpos.f[axis]-from->f[axis];
+            dist+=delta*delta;
+            projection+=delta*(to->f[axis]-from->f[axis]);
+            segment_length_sq+=(to->f[axis]-from->f[axis])*(to->f[axis]-from->f[axis]);
+        }
+        if (projection < 0.0f || projection > segment_length_sq + 0.01f) continue;
+        if (dist<nearest) {
+            nearest=dist; *hit=candidate; *room=rooms[i]; found=1;
+        }
+    }
+    if (!found && final[0]!=0xff) *room=final[0];
+    return found;
+}
