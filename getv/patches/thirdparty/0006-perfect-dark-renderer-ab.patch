--- a/getv/port/fast3d/gfx_sdl2.c
+++ b/getv/port/fast3d/gfx_sdl2.c
@@ -257,0 +258,22 @@
+#ifdef GE_PLATFORM_DESKTOP
+    /* GETV_PD_RENDERER=1: controlled Perfect Dark renderer A/B.
+     *
+     * Adapted from perfect-dark-pc-port/perfect_dark @
+     * 514bf7affd3259b7919165201342ff81a026d92c (MIT; see
+     * LICENSES/perfect-dark-port-MIT.txt).
+     *
+     * Perfect Dark's current PC backend is built around a newer GL/GLSL generation
+     * than this port's inherited sm64ex-style GL2 path.  Do not switch the whole game
+     * globally: request a modern compatibility context only for the experiment so the
+     * existing GoldenEye Fast3D frontend and postfx remain legal while gfx_opengl.c can
+     * exercise the PD-style shader/VAO path below it. */
+    {
+        const char *pd = getenv("GETV_PD_RENDERER");
+        if (pd && *pd == '1') {
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_COMPATIBILITY);
+        }
+    }
+#endif
