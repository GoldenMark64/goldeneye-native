+    geFunctionFlightEvent(GE_FUNFLIGHT_FUNC_GFX_FLUSH_REASON, GE_FUNFLIGHT_PHASE_ENTER,
+                          0, buf_vbo_len, buf_vbo_num_tris, 0);
+    ge_gfxboundary_dump(reason);
+    gfx_flush();
+    geFunctionFlightEvent(GE_FUNFLIGHT_FUNC_GFX_FLUSH_REASON, GE_FUNFLIGHT_PHASE_EXIT,
+                          0, 0, 0, 0);
+    if (ge_funflight_batch_started) {
+        geFunctionFlightEndBatch();
+    }
+}
