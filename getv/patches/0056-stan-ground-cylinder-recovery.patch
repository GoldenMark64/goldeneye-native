diff --git a/src/game/stan_ground_native.h b/src/game/stan_ground_native.h
new file mode 100644
--- /dev/null
+++ b/src/game/stan_ground_native.h
@@ -0,0 +1,210 @@
+#ifndef _STAN_GROUND_NATIVE_H_
+#define _STAN_GROUND_NATIVE_H_
+
+/*
+ * Native-only geometry helpers for STAN ground recovery.
+ *
+ * The selection rule is adapted from Perfect Dark's MIT-licensed
+ * cd_find_ground_finalise() semantics: prefer geometry containing the probe
+ * centre, and only fall back to edge/vertex support within the collision
+ * cylinder when no centre-supporting floor exists.
+ *
+ * Reference:
+ *   n64decomp/perfect_dark
+ *   commit 169ed48bdcbfb3b568b028bd5bebb27680073514
+ *   src/lib/collision.c
+ *   Copyright (c) 2022 Ryan Dwyer, MIT License
+ *
+ * These helpers are deliberately independent of GoldenEye's runtime structs so
+ * the core geometry/selection behavior can be exercised by a ROM-free harness.
+ */
+
+typedef struct GeStanGroundChoiceNative {
+    int valid;
+    int center;
+    int index;
+    float y;
+    float dist_sq;
+} GeStanGroundChoiceNative;
+
+static inline int geStanNativeRoomAllowed(
+    int room,
+    const int *rooms,
+    int room_count)
+{
+    int i;
+
+    if (rooms == 0) {
+        return 1;
+    }
+
+    for (i = 0; i < room_count; i++) {
+        if (rooms[i] == room) {
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+static inline int geStanNativePointInConvexPolygonXZ(
+    const float *points,
+    int count,
+    float x,
+    float z)
+{
+    float area2 = 0.0f;
+    int sign = 0;
+    int i;
+
+    if (points == 0 || count < 3) {
+        return 0;
+    }
+
+    for (i = 0; i < count; i++) {
+        int next = (i + 1) % count;
+        float x1 = points[i * 2 + 0];
+        float z1 = points[i * 2 + 1];
+        float x2 = points[next * 2 + 0];
+        float z2 = points[next * 2 + 1];
+        float cross;
+
+        area2 += x1 * z2 - x2 * z1;
+        cross = (x2 - x1) * (z - z1) - (z2 - z1) * (x - x1);
+
+        if (cross > 0.00001f) {
+            if (sign < 0) {
+                return 0;
+            }
+            sign = 1;
+        } else if (cross < -0.00001f) {
+            if (sign > 0) {
+                return 0;
+            }
+            sign = -1;
+        }
+    }
+
+    /* Collinear/zero-area polygons are not floor support. */
+    if (area2 > -0.00001f && area2 < 0.00001f) {
+        return 0;
+    }
+
+    return sign != 0;
+}
+
+static inline float geStanNativeClosestPointPolygonXZ(
+    const float *points,
+    int count,
+    float x,
+    float z,
+    float *closest_x,
+    float *closest_z)
+{
+    float best = 3.402823466e+38F;
+    float best_x = x;
+    float best_z = z;
+    int i;
+
+    if (points == 0 || count < 2) {
+        if (closest_x != 0) {
+            *closest_x = best_x;
+        }
+        if (closest_z != 0) {
+            *closest_z = best_z;
+        }
+        return best;
+    }
+
+    for (i = 0; i < count; i++) {
+        int next = (i + 1) % count;
+        float x1 = points[i * 2 + 0];
+        float z1 = points[i * 2 + 1];
+        float dx = points[next * 2 + 0] - x1;
+        float dz = points[next * 2 + 1] - z1;
+        float len_sq = dx * dx + dz * dz;
+        float t = 0.0f;
+        float qx;
+        float qz;
+        float dist_sq;
+
+        if (len_sq > 0.0f) {
+            t = ((x - x1) * dx + (z - z1) * dz) / len_sq;
+
+            if (t < 0.0f) {
+                t = 0.0f;
+            } else if (t > 1.0f) {
+                t = 1.0f;
+            }
+        }
+
+        qx = x1 + t * dx;
+        qz = z1 + t * dz;
+        dx = x - qx;
+        dz = z - qz;
+        dist_sq = dx * dx + dz * dz;
+
+        if (dist_sq < best) {
+            best = dist_sq;
+            best_x = qx;
+            best_z = qz;
+        }
+    }
+
+    if (closest_x != 0) {
+        *closest_x = best_x;
+    }
+    if (closest_z != 0) {
+        *closest_z = best_z;
+    }
+
+    return best;
+}
+
+static inline void geStanNativeGroundChoiceInit(GeStanGroundChoiceNative *choice)
+{
+    choice->valid = 0;
+    choice->center = 0;
+    choice->index = -1;
