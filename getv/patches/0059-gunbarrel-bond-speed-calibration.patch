+
+static f32 geGunbarrelSequenceSpeedFromConfig(void)
+{
+    const char *value = getenv("GETV_GUNBARREL_SEQUENCE_SPEED");
+    f32 speed;
+
+    if (value == NULL || *value == '\0') {
+        return 0.692308f;
+    }
+
+    speed = (f32)atof(value);
+
+    /*
+     * This control intentionally supports slowdown only. Faster-than-render
+     * cadence would require multiple authored state steps per render.
+     */
+    if (speed != speed || speed < 0.25f || speed > 1.0f) {
+        return 0.692308f;
+    }
+
+    return speed;
+}
+
+static f32 geGunbarrelBondWalkSpeed(void)
+{
+    const char *value = getenv("GETV_GUNBARREL_BOND_SPEED");
+    f32 speed;
+
+    if (value == NULL || *value == '\0') {
+        return 0.91f;
+    }
+
+    /*
+     * vendor/ge-decomp/include/stdlib.h shadows libc's stdlib.h and declares
+     * atof(), but not strtof(). Calling strtof() here therefore compiled as an
+     * implicit int-returning function: libc put the float in XMM0 while the
+     * caller read EAX. The result was then rejected and silently fell back to
+     * 0.91, which is why 0.8, 0.7 and 0.6 all looked identical in playtesting.
+     */
+    speed = (f32)atof(value);
+
+    /*
+     * Native-port calibration setting for Bond's gunbarrel walk only. Keep
+     * obviously accidental values from destroying the intro while allowing a
+     * useful range around the retail 0.91 walk-animation rate. The friendly
+     * goldeneye.ini key gunbarrel_bond_speed publishes the same GETV gate before
+     * the intro starts.
+     */
+    if (speed != speed || speed < 0.25f || speed > 1.50f) {
+        return 0.91f;
+    }
+
+    {
+        extern void osSyncPrintf(const char *, ...);
+        osSyncPrintf("[getv] gunbarrel: Bond walk speed %.3f\n", (double)speed);
+    }
+    return speed;
+}
+#endif
