+    total = ge_dl_depth >= 0 ? (uint32_t)ge_dl_depth + 1u : 0u;
+    if (total > GE_DL_MAX_DEPTH) total = GE_DL_MAX_DEPTH;
+    count = total;
+    if (count > dl_stack_cap) count = dl_stack_cap;
+    base = total - count;
+    if (dl_stack_base_depth != NULL) *dl_stack_base_depth = base;
+    if (dl_stack_count != NULL) *dl_stack_count = count;
