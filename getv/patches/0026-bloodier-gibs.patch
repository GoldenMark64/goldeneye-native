+/* A splash is a union of overlapping, stretched lobes and trailing specks.
+ * Each lobe is ray-tested from the victim to a point near the first hit, so it
+ * can cover an adjacent mesh triangle without projecting through a corner. */
+static void geBloodSplash(coord3d *from, HitThing *hit, s32 room, coord3d *incoming,
+                          f32 size, u32 *seed, s32 pool, s32 source_room)
+{
+    coord3d normal=hit->normal,tangent,bitangent;
+    f32 length=sqrtf(normal.x*normal.x+normal.y*normal.y+normal.z*normal.z);
+    f32 facing=normal.x*incoming->x+normal.y*incoming->y+normal.z*incoming->z;
+    s32 mode=gePortBloodMode(),i,axis,lobes=mode==2 ? 5:3,specks=mode==2 ? 4:2;
+    if(length<0.0001f) return;
+    if(facing>0.0f) length=-length;
+    for(axis=0;axis<3;axis++) normal.f[axis]/=length;
+    tangent.x=normal.z; tangent.y=0.0f; tangent.z=-normal.x;
+    length=sqrtf(tangent.x*tangent.x+tangent.z*tangent.z);
+    if(length<0.01f) { tangent.x=1.0f; tangent.z=0.0f; }
+    else { tangent.x/=length; tangent.z/=length; }
+    bitangent.x=normal.y*tangent.z-normal.z*tangent.y;
+    bitangent.y=normal.z*tangent.x-normal.x*tangent.z;
+    bitangent.z=normal.x*tangent.y-normal.y*tangent.x;
+    geBloodStain(hit,room,incoming,size,seed,pool);
+    for(i=0;i<lobes+specks;i++) {
+        HitThing nearby;
+        coord3d target=hit->hitpos,velocity;
+        f32 angle=geGibRandUnit(seed)*M_TAU_F;
+        f32 radius=size*(i<lobes ? 0.45f+geGibRandUnit(seed)*0.55f : 1.1f+geGibRandUnit(seed)*0.9f);
+        f32 marksize=size*(i<lobes ? 0.50f+geGibRandUnit(seed)*0.30f : 0.06f+geGibRandUnit(seed)*0.12f);
+        s32 hitroom=source_room;
+        for(axis=0;axis<3;axis++) {
+            target.f[axis]+=radius*(cosf(angle)*tangent.f[axis]+sinf(angle)*bitangent.f[axis])-normal.f[axis]*6.0f;
+            velocity.f[axis]=target.f[axis]-from->f[axis];
+        }
+        if(geBloodTrace(from,&target,&hitroom,&nearby)) {
+            f32 nlength=sqrtf(nearby.normal.x*nearby.normal.x+nearby.normal.y*nearby.normal.y+nearby.normal.z*nearby.normal.z);
+            if(pool && fabsf(nearby.normal.y)<nlength*0.65f) continue;
+            geBloodStain(&nearby,hitroom,&velocity,marksize,seed,pool);
+        }
+    }
+}
+
+static void geBloodPool(coord3d *pos, StandTile *stan, f32 size, u32 seed)
+{
+    coord3d from=*pos,to=*pos,velocity={{0.0f,-1.0f,0.0f}};
+    s32 room=stan ? getTileRoom(stan):0,source_room=room;
+    HitThing hit;
+    from.y+=3.0f; to.y-=320.0f;
+    if(geBloodTrace(&from,&to,&room,&hit)) {
+        if(size>=40.0f) geBloodSplash(&from,&hit,room,&velocity,size,&seed,1,source_room);
+        else geBloodStain(&hit,room,&velocity,size,&seed,1);
+    }
+}
+
+static void geBloodBurst(coord3d *pos, coord3d *direction, StandTile *stan, u32 seed)
+{
+    s32 i,axis,mode=gePortBloodMode(),room=stan ? getTileRoom(stan):0;
+    s32 mist_count=mode==2 ? 14:8,drop_count=mode==2 ? 64:28;
+    coord3d center=*pos;
+    if (!mode || gePortBaseGame() || room<=0 || room>=g_MaxNumRooms) return;
+    center.y+=32.0f;
+    for(i=0;i<mist_count+drop_count;i++) {
+        struct GeBloodDrop *drop=&ge_blood_drops[ge_blood_next_drop++%GE_BLOOD_DROPS];
+        drop->position=center; drop->room=room; drop->age=1;
+        drop->mist=i<mist_count; drop->life=drop->mist ? 22:100;
+        drop->size=drop->mist ? (mode==2?24.0f:18.0f)+geGibRandUnit(&seed)*18.0f : 2.5f+geGibRandUnit(&seed)*(mode==2?4.0f:2.0f);
+        for(axis=0;axis<3;axis++) {
+            drop->position.f[axis]+=(geGibRandUnit(&seed)*2.0f-1.0f)*(drop->mist ? 16.0f:8.0f);
+            drop->velocity.f[axis]=(geGibRandUnit(&seed)*2.0f-1.0f)*(drop->mist?2.8f:9.0f)+direction->f[axis]*(drop->mist?1.8f:5.0f);
+        }
+        if(!drop->mist) drop->velocity.y+=3.0f;
+    }
+    for(i=0;i<(mode==2 ? 10:6);i++) {
+        coord3d to=center,velocity;
+        HitThing hit;
+        s32 hitroom=room;
+        /* Evenly spread directions avoid an unlucky burst missing every nearby
+         * wall. Vertical components deliberately include floor and ceiling rays. */
+        f32 angle=i*(M_TAU_F/(mode==2?10.0f:6.0f))+geGibRandUnit(&seed)*0.4f;
+        f32 reach=mode==2 ? 420.0f:300.0f;
+        velocity.x=cosf(angle)*reach+direction->x*90.0f;
+        velocity.z=sinf(angle)*reach+direction->z*90.0f;
+        velocity.y=(i%3==0 ? -0.7f:i%3==1 ? 0.8f:0.15f)*reach;
+        for(axis=0;axis<3;axis++) to.f[axis]+=velocity.f[axis];
+        if(geBloodTrace(&center,&to,&hitroom,&hit)) geBloodSplash(&center,&hit,hitroom,&velocity,
+            (mode==2?64.0f:44.0f)+geGibRandUnit(&seed)*(mode==2?22.0f:16.0f),&seed,0,room);
+    }
+    /* Put the broad death pool in immediately, not after the chunks settle.
+     * Emit it last so fresh ground coverage receives the same render priority. */
+    geBloodPool(&center,stan,mode==2?90.0f:75.0f,seed);
+    if(getenv("GETV_GIBS_SELFTEST")!=NULL) {
+        s32 stains=0,k,major=0;
+        for(k=0;k<GE_BLOOD_STAINS;k++) if(ge_blood_stains[k].age) { stains++; major+=ge_blood_stains[k].major; }
+        printf("[getv][blood] burst: mode=%d room=%d collision_loaded=%d mist=%d droplets=%d stains=%d major=%d\n",
+            mode,room,g_BgRoomInfo[room].vtx_batch_bounds!=NULL,mist_count,drop_count,stains,major);
+    }
+}
+
+static void geBloodUpdate(s32 steps)
+{
+    s32 i,j,limit=gePortBloodLimit();
+    if(!gePortBloodMode() || gePortBaseGame()) {
+        memset(ge_blood_stains,0,sizeof(ge_blood_stains));
+        memset(ge_blood_drops,0,sizeof(ge_blood_drops));
+        return;
+    }
+    for(i=0;i<GE_BLOOD_STAINS;i++) {
+        struct GeBloodStain *stain=&ge_blood_stains[i];
+        if(i>=limit) stain->age=0;
+        if(stain->age && (stain->age+=steps)>=1860) stain->age=0;
+    }
+    for(i=0;i<GE_BLOOD_DROPS;i++) {
+        struct GeBloodDrop *drop=&ge_blood_drops[i];
+        if(!drop->age) continue;
+        if((drop->age+=steps)>=drop->life) { drop->age=0; continue; }
+        for(j=0;j<steps;j++) {
+            coord3d to=drop->position;
+            HitThing hit;
+            s32 axis,room=drop->room;
+            for(axis=0;axis<3;axis++) to.f[axis]+=drop->velocity.f[axis];
+            if(!drop->mist && geBloodTrace(&drop->position,&to,&room,&hit)) {
+                u32 seed=(u32)(i*977+drop->age*131);
+                geBloodStain(&hit,room,&drop->velocity,drop->size*2.8f,&seed,0);
+                drop->age=0; break;
+            }
+            drop->position=to; drop->room=room;
+            drop->velocity.y-=drop->mist?0.008f:0.18f;
+        }
+    }
+}
