+    /* Diagnostic only: when explicitly requested, force all previously submitted GL
+     * work to complete before presentation. If a long watchdog stall moves here from
+     * SDL_GL_SwapWindow(), the swap was merely the first implicit GPU synchronisation
+     * point; if this returns promptly and present still stalls, the block is genuinely
+     * in the presentation/driver/compositor path. Normal rendering never calls this. */
+    if (gePortStallGfxSyncProbeEnabled()) {
+        gePortStallGfxPhase(8);
+        glFinish();
+    }
