+/* Renderer A/B adapted from perfect-dark-pc-port/perfect_dark @
+ * 514bf7affd3259b7919165201342ff81a026d92c, port/fast3d/gfx_opengl.cpp
+ * (MIT, Copyright (c) 2022 Ryan Dwyer; see LICENSES/perfect-dark-port-MIT.txt).
+ * GoldenEye's vertex/Fast3D frontend is deliberately retained because the Rare games use
+ * incompatible Vtx layouts; this gate changes only the backend generation/state profile. */
+static bool ge_pd_renderer_mode(void) {
+    static int resolved = -1;
+    if (resolved < 0) {
+        const char *e = getenv("GETV_PD_RENDERER");
+        resolved = (e && *e == '1') ? 1 : 0;
+    }
+    return resolved != 0;
+}
