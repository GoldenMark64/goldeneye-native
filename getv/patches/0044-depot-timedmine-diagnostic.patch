+static void ge_depot_obj_debug_destroy(s32 objective_num, s32 tag_id, ObjectRecord *lookup)
+{
+    GeDepotObjectiveDebugState *last;
+    TagObjectRecord *tag;
+    ObjectRecord *tagged;
+    PropRecord *prop;
+    u32 runtime_bitflags;
+    u8 state;
+    s32 destroyed_level;
+    s32 healthy;
+    f32 damage;
+    f32 maxdamage;
+    s32 core_changed;
+    s32 damage_changed;
+
+    if (!ge_obj_dbg() || bossGetStageNum() != LEVELID_DEPOT || objective_num != 1
+            || tag_id < 1 || tag_id > 3)
+    {
+        return;
+    }
+
+    tag = sub_GAME_7F057080(tag_id);
+    tagged = tag ? tag->TaggedObject : NULL;
+    prop = tagged ? tagged->prop : NULL;
+    runtime_bitflags = tagged ? tagged->runtime_bitflags : 0;
+    state = tagged ? tagged->state : 0;
+    destroyed_level = tagged ? objGetDestroyedLevel(tagged) : -1;
+    healthy = tagged ? objIsHealthy(tagged) : -1;
+    damage = tagged ? tagged->damage : -1.0f;
+    maxdamage = tagged ? tagged->maxdamage : -1.0f;
+
+    last = &ge_depot_obj_debug_state[tag_id - 1];
+    core_changed = !last->initialized
+        || last->tag != tag
+        || last->tagged != tagged
+        || last->lookup != lookup
+        || last->prop != prop
+        || last->runtime_bitflags != runtime_bitflags
+        || last->state != state
+        || last->destroyed_level != destroyed_level
+        || last->healthy != healthy;
+    damage_changed = !last->initialized
+        || last->damage != damage
+        || last->maxdamage != maxdamage;
+
+    if (core_changed || (damage_changed && last->damage_lines < 8))
+    {
+        printf("[getv][depot-obj] objective=%d tag=%d tagrec=%p tagged=%p lookup=%p "
+               "type=%d model=%d pad=%d prop=%p proptype=%d runtime=0x%x state=0x%x "
+               "damage=%.3f max=%.3f destroyed=%d healthy=%d\n",
+               objective_num, tag_id, (void *)tag, (void *)tagged, (void *)lookup,
+               tagged ? tagged->type : -1, tagged ? tagged->obj : -1,
+               tagged ? tagged->pad : -1, (void *)prop, prop ? prop->type : -1,
+               runtime_bitflags, state, (double)damage, (double)maxdamage,
+               destroyed_level, healthy);
+        fflush(stdout);
+
+        if (damage_changed && !core_changed)
+        {
+            last->damage_lines++;
+        }
+    }
+
+    last->initialized = 1;
+    last->tag = tag;
+    last->tagged = tagged;
+    last->lookup = lookup;
+    last->prop = prop;
+    last->runtime_bitflags = runtime_bitflags;
+    last->state = state;
+    last->destroyed_level = destroyed_level;
+    last->healthy = healthy;
+    last->damage = damage;
+    last->maxdamage = maxdamage;
+}
+#endif
