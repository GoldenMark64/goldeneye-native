+static s32 ge_proxbox_mine_debug_on(void)
+{
+    static s32 cached = -1;
+
+    if (cached < 0)
+    {
+        const char *e = getenv("GETV_PROXBOX_DEBUG");
+        cached = (e && *e == '1') ? 1 : 0;
+    }
+
+    return cached;
+}
+
+static void ge_proxbox_mine_debug_tick(const char *phase, PropRecord *prop,
+                                       ObjectRecord *obj, WeaponObjRecord *weapon)
+{
+    if (!ge_proxbox_mine_debug_on() || !obj || !weapon
+            || weapon->weaponnum != ITEM_PROXIMITYMINE)
+    {
+        return;
+    }
+
+    printf("[getv][proxbox] %s mine_obj=%p prop=%p model=%d timer=%d "
+           "runtime=0x%x stan=%p pos=(%.1f,%.1f,%.1f)\n",
+           phase, (void *)obj, (void *)prop, obj->obj, weapon->timer,
+           obj->runtime_bitflags, prop ? (void *)prop->stan : NULL,
+           (double)obj->runtime_pos.x, (double)obj->runtime_pos.y,
+           (double)obj->runtime_pos.z);
+    fflush(stdout);
+}
