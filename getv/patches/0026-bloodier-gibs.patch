+/* Dynamic vertices keep alpha/expansion immutable for each submitted view. The
+ * simulation ticks once in lv.c, while each split-screen camera draws its view. */
+static Gfx *geBloodRender(Gfx *gdl, s32 opaque)
+{
+    s32 i,j,axis,active=0;
+    s32 vertex_budget=dynGetFreeVtx()/4, command_budget=dynGetFreeGfx(gdl)/4;
+    s32 draw_count=0,mist_drawn=0,textured=0,limit=gePortBloodLimit();
+    if(!gePortBloodMode() || gePortBaseGame()) return gdl;
+    for(i=0;i<GE_BLOOD_STAINS;i++) active |= ge_blood_stains[i].age;
+    for(i=0;i<GE_BLOOD_DROPS;i++) active |= ge_blood_drops[i].age;
+    if(!active || vertex_budget<512 || command_budget<64) return gdl;
+    if(limit<16) limit=16;
+    if(limit>GE_BLOOD_STAINS) limit=GE_BLOOD_STAINS;
+    if(!ge_blood_mask_ready) {
+        geBloodMakeMask((u8 *)ge_blood_mask_words);
+        ge_blood_mask_ready=1;
+    }
+    gDPPipeSync(gdl++);
+    gDPSetTextureLUT(gdl++,G_TT_NONE);
+    gDPSetTextureLOD(gdl++,G_TL_TILE);
+    gDPSetTextureFilter(gdl++,G_TF_BILERP);
+    gDPSetAlphaCompare(gdl++,G_AC_NONE);
+    gDPLoadTextureBlock(gdl++,ge_blood_mask_words,G_IM_FMT_IA,G_IM_SIZ_8b,
+        GE_BLOOD_MASK_SIZE,GE_BLOOD_MASK_SIZE,0,G_TX_CLAMP,G_TX_CLAMP,6,6,G_TX_NOLOD,G_TX_NOLOD);
+    command_budget-=24;
+    gSPTexture(gdl++,0,0,0,0,G_OFF);
+    gSPClearGeometryMode(gdl++,G_LIGHTING|G_CULL_BOTH|G_FOG);
+    gDPSetCombineMode(gdl++,G_CC_SHADE,G_CC_SHADE);
+    gDPSetRenderMode(gdl++,G_RM_AA_ZB_XLU_SURF,G_RM_AA_ZB_XLU_SURF2);
+    /* Budget each camera independently and reserve three quarters of the free
+     * pools for remaining retail rendering and later split-screen views. Fresh
+     * mist, major splashes, droplets, then specks receive priority in that order.
+     * At most eight mist lobes can consume the budget ahead of surface coverage. */
+    for(i=0;i<2*(limit+GE_BLOOD_DROPS);i++) {
+        coord3d pos,rotation={{0,0,0}};
+        Mtxf matrix;
+        Mtx *fixed;
+        Vtx *verts;
+        s32 count,alpha,mist=0;
+        f32 expansion=1.0f;
+        struct GeBloodStain *stain=NULL;
+        struct GeBloodDrop *drop=NULL;
+        s32 phase_index=i%(limit+GE_BLOOD_DROPS);
+        s32 primary=i<limit+GE_BLOOD_DROPS;
+        if(phase_index>=GE_BLOOD_DROPS) {
+            u32 offset=(u32)(phase_index-GE_BLOOD_DROPS);
+            stain=&ge_blood_stains[(ge_blood_next_stain+(u32)limit-1-offset)%(u32)limit];
+            if(!stain->age || (!!stain->major)!=primary || !getROOMID_isRendered(stain->room)) continue;
+            pos=stain->position; count=stain->count;
+            alpha=stain->age<1740 ? 235:235*(1860-stain->age)/120;
+            if(stain->pool && stain->age<45) expansion=0.85f+0.15f*stain->age/45.0f;
+        } else {
+            drop=&ge_blood_drops[phase_index];
+            if(!drop->age || (!!drop->mist)!=primary || !getROOMID_isRendered(drop->room)) continue;
+            if(drop->mist && mist_drawn>=8) continue;
+            pos=drop->position; count=8; mist=drop->mist;
+            alpha=(mist?140:245)*(drop->life-drop->age)/drop->life;
+            expansion=drop->size*(mist ? 1.0f+drop->age*0.055f:1.0f);
+        }
+        {
+            f32 radius=expansion;
+            if(stain) {
+                f32 radius_sq=0.0f;
+                for(j=0;j<count;j++) {
+                    coord3d *v=&stain->offsets[j];
+                    f32 length_sq=v->x*v->x+v->y*v->y+v->z*v->z;
+                    if(length_sq>radius_sq) radius_sq=length_sq;
+                }
+                radius=sqrtf(radius_sq);
+            }
+            if(!camIsPosInScreen(&pos,radius)) continue;
+        }
+        matrix_4x4_set_position_and_rotation_around_xyz(&pos,&rotation,&matrix);
+        matrix_4x4_multiply_homogeneous_in_place(camGetWorldToScreenMtxf(),&matrix);
+        if(fabsf(matrix.m[3][0])>20000.0f || fabsf(matrix.m[3][1])>20000.0f || fabsf(matrix.m[3][2])>20000.0f) continue;
+        for(j=0;j<3;j++) for(axis=0;axis<3;axis++) matrix.m[j][axis]=(drop ? (j==axis?1.0f:0.0f):matrix.m[j][axis])*0.125f;
+        if(draw_count>=96 || vertex_budget<(s32)(sizeof(Mtx)+(count+1)*sizeof(Vtx)) || command_budget<count+7) break;
+        draw_count++;
+        if(mist) mist_drawn++;
+        vertex_budget-=sizeof(Mtx)+(count+1)*sizeof(Vtx);
+        command_budget-=count+7;
+        fixed=dynAllocateMatrix(); matrix_4x4_f32_to_s32(&matrix,(Mtxf *)fixed);
+        verts=dynAllocateVertices(count+1);
+        memset(verts,0,(count+1)*sizeof(Vtx));
+        /* Fan around the clipped polygon centroid. Pool growth scales inward
+         * toward the impact point, keeping its footprint within the triangle. */
+        for(j=0;j<count;j++) {
+            for(axis=0;axis<3;axis++) {
+                f32 value=stain ? stain->offsets[j].f[axis] : axis==0 ? cosf(j*M_TAU_F/8.0f):axis==1?sinf(j*M_TAU_F/8.0f):0.0f;
+                verts[j+1].v.ob[axis]=(s16)(value*expansion*8.0f);
+            }
+            if(stain) {
+                verts[j+1].v.tc[0]=stain->uv[j][0];
+                verts[j+1].v.tc[1]=stain->uv[j][1];
+            }
+            verts[j+1].v.cn[0]=mist?160:stain?105+stain->shade:130; verts[j+1].v.cn[1]=3; verts[j+1].v.cn[2]=5;
+            verts[j+1].v.cn[3]=mist?0:alpha*3/4;
+        }
