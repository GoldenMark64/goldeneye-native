+static void geBloodStain(HitThing *hit, s32 room, coord3d *incoming, f32 size, u32 *seed, s32 pool)
+{
+    coord3d normal=hit->normal, tangent, bitangent;
+    Vertex *vertices[3]={hit->vtx0,hit->vtx1,hit->vtx2};
+    coord3d *origin=getRoomPositionByIndex(room);
+    GeBloodPoint polygon[GE_BLOOD_POLY_MAX], triangle[3];
+    f32 length=0.0f, dot=0.0f, scale=get_room_data_float1();
+    f32 angle=geGibRandUnit(seed)*M_TAU_F;
+    f32 stretch=pool ? 1.1f : 1.15f+geGibRandUnit(seed)*0.7f;
+    s32 i,axis,count,limit=gePortBloodLimit(),slot=-1,rank=-1,oldest=-1;
+    s32 major=size>=24.0f;
+    struct GeBloodStain *stain;
+    if (gePortBloodMode()==0 || gePortBaseGame() || scale<=0.0f) return;
+    for (axis=0;axis<3;axis++) { length+=normal.f[axis]*normal.f[axis]; dot+=normal.f[axis]*incoming->f[axis]; }
+    if (length<0.0001f) return;
+    length=sqrtf(length)*(dot>0.0f ? -1.0f:1.0f);
+    for(axis=0;axis<3;axis++) normal.f[axis]/=length;
+    tangent.x=normal.z; tangent.y=0.0f; tangent.z=-normal.x;
+    length=sqrtf(tangent.x*tangent.x+tangent.z*tangent.z);
+    if(length<0.01f) { tangent.x=1.0f; tangent.z=0.0f; } else { tangent.x/=length; tangent.z/=length; }
+    bitangent.x=normal.y*tangent.z-normal.z*tangent.y;
+    bitangent.y=normal.z*tangent.x-normal.x*tangent.z;
+    bitangent.z=normal.x*tangent.y-normal.y*tangent.x;
+    for(i=0;i<3;i++) {
+        triangle[i].x=triangle[i].y=0.0f;
+        for(axis=0;axis<3;axis++) {
+            f32 delta=((f32)(axis==0 ? vertices[i]->coord.x : axis==1 ? vertices[i]->coord.y : vertices[i]->coord.z)+origin->f[axis])/scale-hit->hitpos.f[axis];
+            triangle[i].x+=delta*tangent.f[axis]; triangle[i].y+=delta*bitangent.f[axis];
+        }
+    }
+    for(i=0;i<8;i++) {
+        f32 radius=size*1.5f;
+        f32 x=cosf(i*(M_TAU_F/8.0f))*radius*stretch;
+        f32 y=sinf(i*(M_TAU_F/8.0f))*radius/stretch;
+        polygon[i].x=x*cosf(angle)-y*sinf(angle);
+        polygon[i].y=x*sinf(angle)+y*cosf(angle);
+    }
+    count=geBloodClip(polygon,8,triangle);
+    if(count<3 || geBloodPolygonArea(polygon,count)<1.0f) return;
+    if(limit<16) limit=16;
+    if(limit>GE_BLOOD_STAINS) limit=GE_BLOOD_STAINS;
+    /* Fine spray cannot replace the broad masses a moment later. New major
+     * splashes replace minor marks first, then the oldest major mark. */
+    for(i=0;i<limit;i++) {
+        s32 candidate=(ge_blood_next_stain+(u32)i)%(u32)limit;
+        struct GeBloodStain *old=&ge_blood_stains[candidate];
+        s32 candidate_rank=old->major ? 0:1;
+        if(!old->age) { slot=candidate; break; }
+        if(!major && old->major) continue;
+        if(candidate_rank>rank || (candidate_rank==rank && old->age>oldest)) {
+            slot=candidate; rank=candidate_rank; oldest=old->age;
+        }
+    }
+    if(slot<0) return;
+    ge_blood_next_stain=(u32)slot+1;
+    stain=&ge_blood_stains[slot];
+    stain->age=1; stain->count=count; stain->room=room; stain->pool=pool;
+    stain->major=major; stain->shade=(u8)(geGibRand(seed)&31U);
+    for(axis=0;axis<3;axis++) {
+        stain->position.f[axis]=hit->hitpos.f[axis]+normal.f[axis]*0.3f;
+        for(i=0;i<count;i++) stain->offsets[i].f[axis]=polygon[i].x*tangent.f[axis]+polygon[i].y*bitangent.f[axis];
+    }
+    /* UVs use the unclipped splash plane. A triangle cut therefore crops the
+     * same ink image instead of stretching a fresh complete mask to every face. */
+    for(i=0;i<count;i++) {
+        f32 x=(polygon[i].x*cosf(angle)+polygon[i].y*sinf(angle))/stretch;
+        f32 y=(-polygon[i].x*sinf(angle)+polygon[i].y*cosf(angle))*stretch;
+        stain->uv[i][0]=(s16)((x/(size*3.0f)+0.5f)*((GE_BLOOD_MASK_SIZE-1)*32));
+        stain->uv[i][1]=(s16)((y/(size*3.0f)+0.5f)*((GE_BLOOD_MASK_SIZE-1)*32));
+    }
+    ge_blood_surface_hits[normal.y>0.65f ? 0 : normal.y< -0.65f ? 2 : 1]++;
+}
