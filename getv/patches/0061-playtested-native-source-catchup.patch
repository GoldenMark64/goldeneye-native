 #ifdef GE_PORT_NATIVE
+/* GETV_TRAIN_DOOR_DEBUG=1 -- read-only Train locked-door progression probe.
+ * Global list 0x100a watches tags 0x1e..0x28. Each starts with lock bit 0x02
+ * and is unlocked after a guard makes that tagged door leave CLOSED state.
+ * Keep this state-change driven so a long human repro stays readable. */
+#define GE_TRAIN_DOOR_TAG_FIRST 0x1e
+#define GE_TRAIN_DOOR_TAG_LAST  0x28
+#define GE_TRAIN_DOOR_TAG_COUNT (GE_TRAIN_DOOR_TAG_LAST - GE_TRAIN_DOOR_TAG_FIRST + 1)
+#define GE_TRAIN_TRIGGER_GUARD_A 66
+#define GE_TRAIN_TRIGGER_GUARD_B 68
+
+static s32 ge_train_door_debug_on(void)
+{
+    static s32 cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("GETV_TRAIN_DOOR_DEBUG");
+        cached = (e && *e && *e != '0');
+    }
+    return cached;
+}
+
+static s32 ge_train_trigger_guard_slot(ChrRecord *chr)
+{
+    if (chr == NULL) return -1;
+    if (chr->chrnum == GE_TRAIN_TRIGGER_GUARD_A) return 0;
+    if (chr->chrnum == GE_TRAIN_TRIGGER_GUARD_B) return 1;
+    return -1;
+}
+
+static void ge_train_trigger_debug_objective(AIRecord *list, ChrRecord *chr, s32 status, s32 complete)
+{
+    static u8 seen[2];
+    static s32 last_status[2];
+    static s32 last_complete[2];
+    bool isglobal = FALSE;
+    s32 id;
+    s32 slot;
+
+    if (!ge_train_door_debug_on()) return;
+    slot = ge_train_trigger_guard_slot(chr);
+    if (slot < 0) return;
+    if (seen[slot] && last_status[slot] == status && last_complete[slot] == complete) return;
+
+    id = chraiGetAIListID(list, &isglobal);
+    printf("[getv][train-door] trigger-objective chr=%d list=0x%x %s obj0_status=%d complete=%d offset=%d action=%d\n",
+           chr->chrnum, id, isglobal ? "global" : "local", status, complete,
+           chr->aioffset, chr->actiontype);
+    fflush(stdout);
+
+    seen[slot] = 1;
+    last_status[slot] = status;
+    last_complete[slot] = complete;
+}
+
+static void ge_train_trigger_debug_jump(AIRecord *list, ChrRecord *chr, s32 next_id)
+{
+    bool isglobal = FALSE;
+    s32 id;
+
+    if (!ge_train_door_debug_on() || ge_train_trigger_guard_slot(chr) < 0) return;
+    id = chraiGetAIListID(list, &isglobal);
+    printf("[getv][train-door] trigger-jump chr=%d list=0x%x %s ->0x%x offset=%d action=%d\n",
+           chr->chrnum, id, isglobal ? "global" : "local", next_id,
+           chr->aioffset, chr->actiontype);
+    fflush(stdout);
+}
+
+static void ge_train_trigger_debug_run(AIRecord *list, ChrRecord *chr, s32 started)
+{
+    static u8 seen[2];
+    static s32 last_started[2];
+    bool isglobal = FALSE;
+    s32 id;
+    s32 slot;
+
+    if (!ge_train_door_debug_on()) return;
+    slot = ge_train_trigger_guard_slot(chr);
+    if (slot < 0) return;
+    if (seen[slot] && last_started[slot] == started) return;
+
+    id = chraiGetAIListID(list, &isglobal);
+    printf("[getv][train-door] trigger-run chr=%d list=0x%x %s started=%d action=%d pos=(%.1f,%.1f,%.1f)\n",
+           chr->chrnum, id, isglobal ? "global" : "local", started, chr->actiontype,
+           chr->prop ? chr->prop->pos.f[0] : 0.0f,
+           chr->prop ? chr->prop->pos.f[1] : 0.0f,
+           chr->prop ? chr->prop->pos.f[2] : 0.0f);
+    fflush(stdout);
+
+    seen[slot] = 1;
+    last_started[slot] = started;
+}
+
+static s32 ge_train_explosion_debug_on(void)
+{
+    static s32 cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv("GETV_TRAIN_EXPLOSION_DEBUG");
+        cached = (e && *e == '1') ? 1 : 0;
+    }
+    return cached;
+}
+
+static s32 ge_train_explosion_tag(s32 tag)
+{
+    return (tag >= 0x0f && tag <= 0x15) || (tag >= 0x2b && tag <= 0x2d);
+}
+
+static void ge_train_explosion_debug_object(const char *phase, s32 tag, ObjectRecord *obj)
+{
+    WeaponObjRecord *weapon = NULL;
+
+    if (!ge_train_explosion_debug_on() || !ge_train_explosion_tag(tag))
+    {
+        return;
+    }
+
+    if (obj && obj->type == PROPDEF_COLLECTABLE)
+    {
+        weapon = (WeaponObjRecord *) obj;
+    }
+
+    printf("[getv][train-explosion] %s tag=0x%02x obj=%p prop=%p type=%d model=%d pad=%d "
+           "state=0x%x destroyed=%d damage=%.1f maxdamage=%.1f weapon=%d timer=%d "
+           "pos=(%.1f,%.1f,%.1f)\n",
+           phase, tag, (void *) obj, obj ? (void *) obj->prop : NULL,
+           obj ? obj->type : -1, obj ? obj->obj : -1, obj ? obj->pad : -1,
+           obj ? obj->state : 0, obj ? objGetDestroyedLevel(obj) : -1,
+           obj ? (double) obj->damage : 0.0, obj ? (double) obj->maxdamage : 0.0,
+           weapon ? weapon->weaponnum : -1, weapon ? weapon->timer : -1,
+           obj ? (double) obj->runtime_pos.x : 0.0,
+           obj ? (double) obj->runtime_pos.y : 0.0,
+           obj ? (double) obj->runtime_pos.z : 0.0);
+    fflush(stdout);
+}
+
+static void ge_train_door_debug_watch(AIRecord *list, DoorRecord *door, s32 tag, s32 pass)
+{
+    static u8 seen[GE_TRAIN_DOOR_TAG_COUNT];
+    static DoorRecord *last_door[GE_TRAIN_DOOR_TAG_COUNT];
+    static s32 last_state[GE_TRAIN_DOOR_TAG_COUNT];
+    static s32 last_keyflags[GE_TRAIN_DOOR_TAG_COUNT];
+    static s32 last_closed[GE_TRAIN_DOOR_TAG_COUNT];
+    static s32 last_pass[GE_TRAIN_DOOR_TAG_COUNT];
+    bool isglobal = FALSE;
+    s32 id;
+    s32 closed;
+    s32 slot;
+
+    if (!ge_train_door_debug_on() || door == NULL) return;
+    if (tag < GE_TRAIN_DOOR_TAG_FIRST || tag > GE_TRAIN_DOOR_TAG_LAST) return;
+
+    slot = tag - GE_TRAIN_DOOR_TAG_FIRST;
+
+    closed = door->openPosition <= 0.0f;
+    if (seen[slot]
+        && door == last_door[slot]
+        && door->openstate == last_state[slot]
+        && door->keyflags == last_keyflags[slot]
+        && closed == last_closed[slot]
+        && pass == last_pass[slot]) {
+        return;
+    }
+
+    id = chraiGetAIListID(list, &isglobal);
+    printf("[getv][train-door] ai-watch tag=0x%02x list=0x%x %s door=%p pad=%d state=%d open=%.3f key=0x%x closed=%d pass=%d\n",
+           tag, id, isglobal ? "global" : "local", (void *)door, door->pad, door->openstate,
+           door->openPosition, door->keyflags, closed, pass);
+    fflush(stdout);
+
+    seen[slot] = 1;
+    last_door[slot] = door;
+    last_state[slot] = door->openstate;
+    last_keyflags[slot] = door->keyflags;
+    last_closed[slot] = closed;
+    last_pass[slot] = pass;
+}
+
+static void ge_train_door_debug_unlock(AIRecord *list, DoorRecord *door, s32 tag, u8 bits, u8 before)
+{
+    static u8 seen[GE_TRAIN_DOOR_TAG_COUNT];
+    static u8 last_before[GE_TRAIN_DOOR_TAG_COUNT];
+    static u8 last_after[GE_TRAIN_DOOR_TAG_COUNT];
+    bool isglobal = FALSE;
+    s32 id;
+    s32 slot;
+
+    if (!ge_train_door_debug_on() || door == NULL) return;
+    if (tag < GE_TRAIN_DOOR_TAG_FIRST || tag > GE_TRAIN_DOOR_TAG_LAST) return;
+
+    slot = tag - GE_TRAIN_DOOR_TAG_FIRST;
+    if (seen[slot] && last_before[slot] == before && last_after[slot] == door->keyflags) return;
+
+    id = chraiGetAIListID(list, &isglobal);
+    printf("[getv][train-door] unlock tag=0x%02x list=0x%x %s door=%p pad=%d bits=0x%x key=0x%x->0x%x state=%d open=%.3f\n",
+           tag, id, isglobal ? "global" : "local", (void *)door, door->pad, bits, before, door->keyflags,
+           door->openstate, door->openPosition);
+    fflush(stdout);
+    seen[slot] = 1;
+    last_before[slot] = before;
+    last_after[slot] = door->keyflags;
+}
