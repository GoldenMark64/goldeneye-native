--- a/getv/port/fast3d/gfx_pc.c
+++ b/getv/port/fast3d/gfx_pc.c
@@ -5289,0 +5290,23 @@
+void gfx_get_flight_command_context(int *progress, int *depth, uint32_t *opcode,
+                                    uintptr_t *w0, uintptr_t *w1)
+{
+    unsigned int cur;
+    const struct gfx_trace_entry *e;
+
+    if (progress != NULL) *progress = ge_stall_gfx_cmd_progress;
+    if (depth != NULL) *depth = ge_dl_depth;
+
+    if (gfx_trace_total == 0) {
+        if (opcode != NULL) *opcode = 0;
+        if (w0 != NULL) *w0 = 0;
+        if (w1 != NULL) *w1 = 0;
+        return;
+    }
+
+    cur = (gfx_trace_pos + GFX_TRACE_N - 1) % GFX_TRACE_N;
+    e = &gfx_trace[cur];
+    if (opcode != NULL) *opcode = (uint32_t)((e->w0 >> 24) & 0xffu);
+    if (w0 != NULL) *w0 = e->w0;
+    if (w1 != NULL) *w1 = e->w1;
+}
+
